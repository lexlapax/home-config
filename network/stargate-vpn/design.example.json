    "nat": "IPv4 and IPv6; only exit-client traffic leaving wg-vpn",
    "deny_private_and_site_destinations": true,
    "vpn_dns_exception": "exact configured resolvers, TCP/UDP 53 only",
    "guard_before_tailscale_accepts": true
  },
  "failure_policy": {
    "vpn_down": "no internet; exit may become unreachable",
    "missing_default_routes": "unreachable; no WAN interface or fallback",
    "automatic_home_fallback": false,
    "other_exit_nodes": "client must explicitly choose; inspect managed auto-selection policy"
  },
  "private_inputs_required": [
    "new independent VPN private-key file",
    "VPN peer public key and literal endpoint address/port",
    "VPN IPv4 and IPv6 tunnel addresses and resolver addresses",
    "tailnet enrollment and restricted exit-node tag/policy",
    "site private/public protected destination prefixes"
  ]
}
