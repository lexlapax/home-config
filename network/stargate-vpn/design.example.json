{
  "status": "review-only; not a deployable configuration",
  "operator_profile": "vpn",
  "exit_identity": "stargate-vpn",
  "network_namespace": "stargate-vpn",
  "tunnel_interface": "wg-vpn",
  "tailscale_interface": "tailscale0",
  "ordinary_network_interfaces": [],
  "wireguard_socket_birthplace": "host",
  "wireguard_interface_location": "stargate-vpn",
  "independent_vpn_credential": true,
  "reuse_existing_tunnel_or_key": false,
  "underlay": "existing host WAN; encrypted WireGuard transport only",
  "namespace_default_egress": "wg-vpn",
  "families": ["ipv4", "ipv6"],
  "namespace_dns": "private deployment VPN resolver addresses",
  "tailscale": {
    "socket": "/run/tailscale-vpn/tailscaled.sock",
    "state_directory": "/var/lib/tailscale-vpn",
    "hostname": "stargate-vpn",
    "accept_dns": false,
    "accept_routes": false,
    "advertise_exit_node": true,
    "advertise_subnet_routes": [],
    "ssh": false,
    "webclient": false
  },
  "forwarding": {
    "allowed_new_path": "tailscale0 -> wg-vpn",
